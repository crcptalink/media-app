[Unit]
Description=Pull and deploy Link Roster (media-app)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
SupplementaryGroups=docker
WorkingDirectory=/home/deploy/media-app
Environment=HOME=/home/deploy
Environment=GIT_TERMINAL_PROMPT=0
Environment=DOCKER_BUILDKIT=1
Environment=COMPOSE_DOCKER_CLI_BUILD=1
Environment=BUILDKIT_PROGRESS=plain
Environment=COMPOSE_ANSI=never
ExecStart=/bin/bash /home/deploy/media-app/deploy/auto-deploy.sh
TimeoutStartSec=60min
Nice=10
SyslogIdentifier=media-app-deploy
