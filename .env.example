# Link Roster configuration. Copy to .env and fill in. Never commit .env.

# --- Database (used by docker-compose; generate with: openssl rand -hex 24) ---
POSTGRES_PASSWORD=change-me-hex-only
# For running outside Docker (npm run dev). Compose sets this itself for the app container.
DATABASE_URL=postgresql://link:change-me-hex-only@localhost:5432/linkroster

# --- Auth.js --- generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://192.168.81.99:3000
AUTH_TRUST_HOST=true
# Base URL used in emails, QR codes and calendar invites
APP_URL=http://192.168.81.99:3000

# --- Email (Gmail SMTP with an app password; needs 2-Step Verification on the account) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=crcptalink@gmail.com
SMTP_APP_PASSWORD=
EMAIL_FROM="CRC PTA Link <crcptalink@gmail.com>"
EVENT_LOCATION="CRC Pretoria"

# --- First admin / lead (created by: docker compose exec app npm run seed) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME="Tech Boost"
# Optional: also give the admin a password (otherwise sign in with an email link, then set one in the app)
SEED_ADMIN_PASSWORD=

# --- Screens: long random strings (openssl rand -hex 16) ---
TV_TOKEN=
KIOSK_TOKEN=

# --- Check-in: minutes after the arrival time before someone counts as late (editable later on Setup) ---
CHECKIN_GRACE_MIN=5

# --- Backups (backup service) ---
BACKUP_TIME=02:00
BACKUP_KEEP_DAYS=30

TZ=Africa/Johannesburg
